<% content_for :title, "Nova Opção - #{@questionnaire.title}" %>

<div class="container py-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="display-4 fw-bold text-dark">Nova Opção de Resposta</h1>
          <p class="lead text-muted">Questionário: <%= @questionnaire.title %></p>
          <p class="text-muted">Pergunta: <%= @question.enunciation %></p>
        </div>
        <div>
          <%= link_to "Voltar", questionnaire_question_question_options_path(@questionnaire, @question), 
              class: "btn btn-outline-secondary" %>
        </div>
      </div>
    </div>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-sm">
        <div class="card-header">
          <h5 class="card-title mb-0">Criar Nova Opção</h5>
        </div>
        <div class="card-body">
          <%= form_with model: [@questionnaire, @question, @question_option], local: true, class: "needs-validation", novalidate: true do |form| %>
            <% if @question_option.errors.any? %>
              <div class="alert alert-danger">
                <h6>Foram encontrados <%= @question_option.errors.count %> erro(s):</h6>
                <ul class="mb-0">
                  <% @question_option.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= form.label :title, "Texto da Opção", class: "form-label fw-bold" %>
              <%= form.text_field :title, 
                  class: "form-control", 
                  placeholder: "Digite o texto da opção de resposta...",
                  required: true %>
              <div class="form-text">
                Descreva claramente esta opção de resposta.
              </div>
            </div>

            <div class="mb-3">
              <%= form.label :position, "Posição", class: "form-label fw-bold" %>
              <%= form.number_field :position, 
                  class: "form-control", 
                  value: @question.question_options.count + 1,
                  min: 1,
                  required: true %>
              <div class="form-text">
                Ordem em que a opção aparecerá na pergunta.
              </div>
            </div>

            <div class="mb-3">
              <div class="form-check">
                <%= form.check_box :correct, class: "form-check-input" %>
                <%= form.label :correct, "Esta é a resposta correta", class: "form-check-label fw-bold" %>
              </div>
              <div class="form-text">
                Marque esta opção se ela for a resposta correta para a pergunta.
              </div>
            </div>

            <div class="alert alert-info">
              <i class="bi bi-info-circle me-2"></i>
              <strong>Dica:</strong> Certifique-se de marcar pelo menos uma opção como correta.
            </div>

            <div class="d-flex gap-2">
              <%= form.submit "Criar Opção", class: "btn btn-primary btn-lg" %>
              <%= link_to "Cancelar", questionnaire_question_question_options_path(@questionnaire, @question), 
                  class: "btn btn-outline-secondary btn-lg" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Validação do formulário
(function() {
  'use strict';
  window.addEventListener('load', function() {
    var forms = document.getElementsByClassName('needs-validation');
    var validation = Array.prototype.filter.call(forms, function(form) {
      form.addEventListener('submit', function(event) {
        if (form.checkValidity() === false) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
  }, false);
})();
</script>
