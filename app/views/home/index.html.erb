<% content_for :title, "Dashboard" %>

<div class="container py-4">
  <!-- Header -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="display-4 fw-bold text-dark">Dashboard</h1>
          <p class="lead text-muted">Gerencie seus questionários e acompanhe seu progresso</p>
        </div>
        
      </div>
    </div>
  </div>
  
  <div class="row">
    <!-- Questionários Disponíveis -->
    <div class="col-lg-8">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 fw-semibold text-dark">Questionários Disponíveis</h2>
        <span class="badge bg-primary fs-6">
          <%= @questionnaires.count %> disponíveis
        </span>
      </div>
      
      <div class="row g-4">
        <% if @questionnaires.any? %>
          <% @questionnaires.each do |questionnaire| %>
            <div class="col-12">
              <div class="card h-100 shadow-sm">
                <div class="card-body">
                  <h5 class="card-title fw-semibold"><%= questionnaire.title %></h5>
                  <p class="card-text text-muted">
                    <strong>Código:</strong> <%= questionnaire.code %><br>
                    <%= questionnaire.description %>
                  </p>
                  <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge bg-success">
                      <i class="bi bi-clock me-1"></i>
                      <%= questionnaire.duration_minutes %> min
                    </span>
                    <span class="badge bg-info">
                      <i class="bi bi-list-ul me-1"></i>
                      <%= questionnaire.total_questions %> perguntas
                    </span>
                  </div>
                </div>
                <div class="card-footer bg-light">
                  <div class="d-grid gap-2 d-md-flex">
                    <%= link_to questionnaire_path(questionnaire), class: "btn btn-outline-secondary flex-fill" do %>
                      Ver Detalhes
                    <% end %>
                    <%= link_to take_questionnaire_path(questionnaire), class: "btn btn-primary flex-fill" do %>
                      Responder Quiz
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="col-12">
            <div class="card text-center">
              <div class="card-body py-5">
                <i class="bi bi-file-text display-1 text-muted"></i>
                <h5 class="card-title mt-3">Nenhum questionário</h5>
                <p class="card-text text-muted">Nenhum questionário disponível</p>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    
    <!-- Resultados Recentes -->
    <div class="col-lg-4">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 fw-semibold text-dark">Resultados Recentes</h2>
        <span class="badge bg-secondary">
          <%= @user_results.count %> resultados
        </span>
      </div>
      
      <div class="row g-3">
        <% if @user_results.any? %>
          <% @user_results.each do |result| %>
            <div class="col-12">
              <div class="card">
                <div class="card-body">
                  <h6 class="card-title fw-semibold"><%= result.questionnaire.title %></h6>
                  <div class="row g-2 mb-3">
                    <div class="col-6">
                      <small class="text-muted">Score:</small>
                      <div class="fw-bold text-success fs-5"><%= result.score %>%</div>
                    </div>
                    <div class="col-6">
                      <small class="text-muted">Nota:</small>
                      <div>
                        <span class="badge bg-primary"><%= result.grade %></span>
                      </div>
                    </div>
                    <div class="col-12">
                      <small class="text-muted">Data:</small>
                      <div class="small"><%= result.submitted_at.strftime("%d/%m/%Y") %></div>
                    </div>
                  </div>
                  <%= link_to quiz_results_path(1), class: "btn btn-outline-secondary w-100" do %>
                    Ver Detalhes
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="col-12">
            <div class="card text-center">
              <div class="card-body py-4">
                <i class="bi bi-graph-up display-4 text-muted"></i>
                <h6 class="card-title mt-3">Nenhum resultado</h6>
                <p class="card-text small text-muted">Comece respondendo um questionário para ver seus resultados aqui.</p>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
