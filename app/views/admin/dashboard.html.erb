<% content_for :title, "Dashboard Administrativo" %>

<div class="container py-4">
  <!-- Header -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="display-4 fw-bold text-dark">Dashboard Administrativo</h1>
          <p class="lead text-muted">Bem-vindo, <%= current_user.name %>! Gerencie o sistema de questionários</p>
        </div>
        <div class="text-end">
          <span class="badge bg-success fs-6">
            <i class="bi bi-shield-check me-1"></i>
            Administrador
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="row g-4 mb-5">
    <div class="col-lg-3 col-md-6">
      <div class="card bg-primary text-white h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h6 class="card-title text-white-50">Total de Usuários</h6>
              <h2 class="fw-bold mb-0"><%= @total_users %></h2>
            </div>
            <div class="align-self-center">
              <i class="bi bi-people display-4 opacity-75"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-3 col-md-6">
      <div class="card bg-success text-white h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h6 class="card-title text-white-50">Questionários</h6>
              <h2 class="fw-bold mb-0"><%= @total_questionnaires %></h2>
            </div>
            <div class="align-self-center">
              <i class="bi bi-file-text display-4 opacity-75"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-3 col-md-6">
      <div class="card bg-info text-white h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h6 class="card-title text-white-50">Perguntas</h6>
              <h2 class="fw-bold mb-0"><%= @total_questions %></h2>
            </div>
            <div class="align-self-center">
              <i class="bi bi-question-circle display-4 opacity-75"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-3 col-md-6">
      <div class="card bg-warning text-white h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h6 class="card-title text-white-50">Resultados</h6>
              <h2 class="fw-bold mb-0"><%= @total_results %></h2>
            </div>
            <div class="align-self-center">
              <i class="bi bi-graph-up display-4 opacity-75"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="row mb-5">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">
            <i class="bi bi-lightning me-2"></i>
            Ações Rápidas
          </h5>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-lg-3 col-md-6">
              <%= link_to admin_users_path, class: "btn btn-outline-primary w-100 py-3" do %>
                <i class="bi bi-people d-block mb-2 fs-2"></i>
                Gerenciar Usuários
              <% end %>
            </div>
            <div class="col-lg-3 col-md-6">
              <%= link_to admin_questionnaires_path, class: "btn btn-outline-success w-100 py-3" do %>
                <i class="bi bi-file-text d-block mb-2 fs-2"></i>
                Gerenciar Questionários
              <% end %>
            </div>
            <div class="col-lg-3 col-md-6">
              <%= link_to admin_signup_path, class: "btn btn-outline-info w-100 py-3" do %>
                <i class="bi bi-person-plus d-block mb-2 fs-2"></i>
                Cadastrar Admin
              <% end %>
            </div>
            <div class="col-lg-3 col-md-6">
              <%= link_to authenticated_root_path, class: "btn btn-outline-secondary w-100 py-3" do %>
                <i class="bi bi-house d-block mb-2 fs-2"></i>
                Voltar ao Dashboard
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Results -->
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">
            <i class="bi bi-clock-history me-2"></i>
            Resultados Recentes
          </h5>
        </div>
        <div class="card-body">
          <% if @recent_results.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Usuário</th>
                    <th>Questionário</th>
                    <th>Score</th>
                    <th>Nota</th>
                    <th>Data</th>
                  </tr>
                </thead>
                <tbody>
                  <% @recent_results.each do |result| %>
                    <tr>
                      <td>
                        <div class="d-flex align-items-center">
                          <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3">
                            <%= result.user.name.first.upcase %>
                          </div>
                          <div>
                            <h6 class="mb-0"><%= result.user.name %></h6>
                            <small class="text-muted"><%= result.user.email %></small>
                          </div>
                        </div>
                      </td>
                      <td><%= result.questionnaire.title %></td>
                      <td>
                        <span class="badge bg-<%= result.score >= 70 ? 'success' : result.score >= 50 ? 'warning' : 'danger' %>">
                          <%= result.score %>%
                        </span>
                      </td>
                      <td>
                        <span class="badge bg-primary"><%= result.grade %></span>
                      </td>
                      <td><%= result.submitted_at.strftime("%d/%m/%Y %H:%M") %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="bi bi-graph-up display-1 text-muted"></i>
              <h5 class="mt-3">Nenhum resultado encontrado</h5>
              <p class="text-muted">Os resultados dos questionários aparecerão aqui quando os usuários começarem a responder.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.avatar-sm {
  width: 40px;
  height: 40px;
  font-size: 16px;
  font-weight: bold;
}

.card {
  transition: all 0.2s ease;
}

.card:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

.btn {
  transition: all 0.2s ease;
}

.btn:hover {
  transform: translateY(-1px);
}

.table th {
  border-top: none;
  font-weight: 600;
  color: #495057;
}

.table td {
  vertical-align: middle;
}
</style>





