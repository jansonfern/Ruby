<% content_for :title, "Perguntas - #{@questionnaire.title}" %>

<div class="container py-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="display-4 fw-bold text-dark">Perguntas</h1>
          <p class="lead text-muted">Questionário: <%= @questionnaire.title %></p>
        </div>
        <div>
          <%= link_to "Nova Pergunta", new_questionnaire_question_path(@questionnaire), 
              class: "btn btn-primary btn-lg" %>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <% if @questions.any? %>
        <div class="card shadow-sm">
          <div class="card-body">
            <div class="list-group list-group-flush">
              <% @questions.each_with_index do |question, index| %>
                <div class="list-group-item">
                  <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                      <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-primary me-2">#<%= question.position %></span>
                        <h5 class="mb-0">Pergunta <%= index + 1 %></h5>
                      </div>
                      <p class="mb-2"><%= question.enunciation %></p>
                      
                      <% if question.question_options.any? %>
                        <div class="mt-3">
                          <h6 class="text-muted mb-2">Opções de Resposta:</h6>
                          <div class="row">
                            <% question.question_options.each_with_index do |option, opt_index| %>
                              <div class="col-md-6 mb-2">
                                <div class="card border-<%= option.correct? ? 'success' : 'light' %>">
                                  <div class="card-body py-2">
                                    <div class="d-flex align-items-center">
                                      <span class="badge bg-<%= option.correct? ? 'success' : 'secondary' %> me-2">
                                        <%= ('A'..'Z').to_a[opt_index] %>
                                      </span>
                                      <span class="<%= option.correct? ? 'text-success fw-bold' : '' %>">
                                        <%= option.title %>
                                      </span>
                                      <% if option.correct? %>
                                        <i class="bi bi-check-circle-fill text-success ms-auto"></i>
                                      <% end %>
                                    </div>
                                  </div>
                                </div>
                              </div>
                            <% end %>
                          </div>
                        </div>
                      <% else %>
                        <div class="alert alert-warning py-2">
                          <i class="bi bi-exclamation-triangle me-1"></i>
                          Esta pergunta não possui opções de resposta.
                        </div>
                      <% end %>
                    </div>
                    
                    <div class="ms-3">
                      <div class="btn-group-vertical" role="group">
                        <%= link_to "Editar", edit_questionnaire_question_path(@questionnaire, question), 
                            class: "btn btn-outline-warning btn-sm" %>
                        <%= link_to "Gerenciar Opções", questionnaire_question_question_options_path(@questionnaire, question), 
                            class: "btn btn-outline-info btn-sm" %>
                        <%= link_to "Excluir", questionnaire_question_path(@questionnaire, question), 
                            method: :delete, 
                            data: { confirm: "Tem certeza que deseja excluir esta pergunta?" },
                            class: "btn btn-outline-danger btn-sm" %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="card shadow-sm">
          <div class="card-body text-center py-5">
            <i class="bi bi-question-circle display-1 text-muted mb-3"></i>
            <h3 class="text-muted">Nenhuma pergunta encontrada</h3>
            <p class="text-muted mb-4">Este questionário ainda não possui perguntas.</p>
            <%= link_to "Criar Primeira Pergunta", new_questionnaire_question_path(@questionnaire), 
                class: "btn btn-primary btn-lg" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="row mt-4">
    <div class="col-12">
      <div class="d-flex gap-2">
        <%= link_to "Voltar ao Questionário", questionnaire_path(@questionnaire), 
            class: "btn btn-outline-secondary" %>
        <%= link_to "Todos os Questionários", questionnaires_path, 
            class: "btn btn-outline-primary" %>
      </div>
    </div>
  </div>
</div>
