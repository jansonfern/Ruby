<% content_for :title, "Questionários" %>

<div class="container py-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="display-4 fw-bold text-dark">Questionários</h1>
          <p class="lead text-muted">Escolha um questionário para responder</p>
        </div>
        <% if policy(Questionnaire).create? %>
          <div>
            <%= link_to new_questionnaire_path, class: "btn btn-primary btn-lg" do %>
              <i class="bi bi-plus-circle me-2"></i>
              Novo Questionário
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <% if @questionnaires.any? %>
      <% @questionnaires.each do |questionnaire| %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <h5 class="card-title fw-bold text-dark mb-0"><%= questionnaire.title %></h5>
                <span class="badge bg-primary"><%= questionnaire.code %></span>
              </div>
              <p class="card-text text-muted flex-grow-1"><%= questionnaire.description %></p>
              <div class="mt-auto">
                <div class="row text-center mb-3">
                  <div class="col-6">
                    <small class="text-muted d-block">Duração</small>
                    <strong><%= questionnaire.duration_minutes %> min</strong>
                  </div>
                  <div class="col-6">
                    <small class="text-muted d-block">Perguntas</small>
                    <strong><%= questionnaire.total_questions %></strong>
                  </div>
                </div>
                <div class="d-flex gap-2">
                  <%= link_to "Responder Quiz", take_questionnaire_path(questionnaire), 
                      class: "btn btn-primary flex-grow-1 fw-semibold" %>
                  <%= link_to "Ver Detalhes", questionnaire_path(questionnaire), 
                      class: "btn btn-outline-secondary" %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="col-12">
        <div class="card text-center">
          <div class="card-body py-5">
            <i class="bi bi-file-text display-1 text-muted"></i>
            <h5 class="card-title mt-3">Nenhum questionário disponível</h5>
            <p class="card-text text-muted">Não há questionários disponíveis no momento.</p>
            <% if policy(Questionnaire).create? %>
              <%= link_to "Criar Primeiro Questionário", new_questionnaire_path, 
                  class: "btn btn-primary mt-3" %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>